# 复制为 .env 后按你的运行方式选择其一：
#
# 1) 本机直接运行（MySQL 在本机 3306）
# DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/rc_db
#
# 2) docker-compose 运行（MySQL 服务名是 db）
DATABASE_URL=mysql+pymysql://root:123456@db:3306/rc_db

# AES-CBC 加密用 key/iv
# 约定：直接使用 UTF-8 字符串，长度要求：
# - AES_KEY 必须是 16/24/32 字节
# - AES_IV 必须是 16 字节
AES_KEY=b8c3f2e9a6d47c5b1e9032f4d8a1c6e2
AES_IV=9d4a1f7c2e6b8a03

# 管理员接口口令（/admin 下接口使用）
ADMIN_PASSWORD=VvHw5Gi5zFvfCRpD
# V2 管理员 API Bearer Token；未设置时临时回退使用 ADMIN_PASSWORD
ADMIN_API_TOKEN=replace-with-a-long-random-token

# 后台管理页面 Session 密钥（随便 32+ 位随机字符串即可）
ADMIN_UI_SESSION_SECRET=8y1tqyWc7Tv7zvqKHHcJQUJqJVGq8fTh3eAyy5jWiJQY1WvuCJkGgDNsz3eRrngb

# 外部接口（/match/detail 会调用）
MATCH_API_BASE_URL=https://fccdn1.k4n.cc/fc/wx_api/v1/MiniApp/getMatchInfo
MATCH_API_LID2=255143
# 只填 token 本体（不要带 "Bearer " 前缀）
MATCH_API_BEARER=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJ1aWQiOjI1NTE0Mywib2lkIjoiY2IwZDRiYjA2ODNhZmVmMWFiOGNlMzE4ZjdkNTZlMzMiLCJsaWQiOjAsInNpZGUiOiJ3eF9hcGkiLCJhdWQiOiIiLCJleHAiOjE3NzU2MzkyMTAsImlhdCI6MTc3NTU2NzIxMCwiaXNzIjoiIiwianRpIjoiYTE4Njc3NTRhMmUyOThhZGVhOWNkZjViM2NjNzBkMTciLCJuYmYiOjE3NzU1NjcyMTAsInN1YiI6IiJ9.vve1yTdwrdsvBjU3HEMxeBM_KJ5N7eQLGxppEEKnoes

# 公开查询限流
# 1) 本机直接运行
# REDIS_URL=redis://localhost:6379/0

# 2) docker-compose
REDIS_URL=redis://redis:6379/0
QUERY_COOLDOWN_SECONDS=30

