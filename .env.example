# 复制为 .env 后按你的运行方式选择其一：
#
# 1) 本机直接运行（MySQL 在本机 3306）
# DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/rc_db
#
# 2) docker-compose 运行（MySQL 服务名是 db）
DATABASE_URL=mysql+pymysql://root:123456@db:3306/rc_db

# ====== 安全配置（请务必改成你自己的随机值）======
# 签名密钥：建议使用 >= 16 位随机字符串
SIGN_SECRET=he93GjVTFEFWrUU4

# AES-CBC 加密用 key/iv
# 约定：直接使用 UTF-8 字符串，长度要求：
# - AES_KEY 必须是 16/24/32 字节
# - AES_IV 必须是 16 字节
AES_KEY=b8c3f2e9a6d47c5b1e9032f4d8a1c6e2
AES_IV=9d4a1f7c2e6b8a03

# 管理员接口口令（/admin 下接口使用）
ADMIN_PASSWORD=VvHw5Gi5zFvfCRpD

# SMTP（用于下单成功邮件通知；不配置则跳过发信）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SENDER_NAME=凤凰山票务
SMTP_USER=fhspw028@qq.com
SMTP_PASSWORD=frbhcmlpddwejcfc

